    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mcstudio</AssemblyName>
    <RootNamespace>MinecraftStudio.Cli</RootNamespace>
    <Product>IcyModz420's Minecraft Studio</Product>
    <Company>IcyModz420</Company>
